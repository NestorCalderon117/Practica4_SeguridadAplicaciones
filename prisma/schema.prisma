generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  CLIENTE
  ADMIN
}

enum EstadoTicket {
  ABIERTO
  EN_PROGRESO
  CERRADO
  CANCELADO
}

enum CategoriaTicket {
  TECNICO
  FACTURACION
  GENERAL
  BUG_REPORT
  FEATURE_REQUEST
}

enum TipoEventoAuditoria {
  LOGIN_SUCCESS
  LOGIN_FAILED
  MFA_SENT
  MFA_SUCCESS
  MFA_FAILED
  ROLE_CHANGED
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  PASSWORD_CHANGED
  EMAIL_CHANGED
  EMAIL_VERIFIED
  PROFILE_UPDATED
  TICKET_CREATED
  TICKET_UPDATED
  TICKET_DELETED
  SESSION_TERMINATED
  ALL_SESSIONS_TERMINATED
  MFA_REENROLL
  USER_CREATED
  USER_BLOCKED
  USER_UNBLOCKED
  MFA_RESET
}

model Usuario {
  id                        String    @id @default(uuid())
  nombre                    String
  apellido                  String
  correo                    String    @unique
  contraseniaHash           String
  rol                       Rol       @default(CLIENTE)
  estaActivo                Boolean   @default(true)
  intentosFallidos          Int       @default(0)
  bloqueadoHasta            DateTime?
  mfaToken                  String?
  mfaTokenExpiraEn          DateTime?
  correoVerificado          Boolean   @default(false)
  codigoRecuperacionVerificado Boolean @default(false)
  creado                    DateTime  @default(now())
  actualizado               DateTime  @updatedAt

  // Relaciones para el módulo Mi Cuenta
  sesiones                  SesionUsuario[]
  historialContrasenias     HistorialContrasenia[]
  historialActividad        HistorialActividad[]
  dispositivosMfa           DispositivoMfa[]
  
  // Relaciones para el módulo Tickets
  tickets                   Ticket[]
  
  // Relaciones para el módulo Administración
  accionesAdministrativas   HistorialActividad[] @relation("AdminActions")
}

model SesionUsuario {
  id              String   @id @default(uuid())
  usuarioId       String
  deviceId        String   @unique
  userAgent       String?
  ipAddress       String?
  ubicacion       String?
  ultimaActividad DateTime @default(now())
  expiraEn        DateTime
  activa          Boolean  @default(true)
  creada          DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("sesiones_usuario")
}

model HistorialContrasenia {
  id            String   @id @default(uuid())
  usuarioId     String
  contraseniaHash String
  fechaCreacion DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("historial_contrasenias")
}

model HistorialActividad {
  id        String   @id @default(uuid())
  usuarioId String
  tipo      TipoEventoAuditoria
  descripcion String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  fecha     DateTime @default(now())
  adminId   String?  // ID del admin que realizó la acción (para acciones administrativas)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  admin   Usuario? @relation("AdminActions", fields: [adminId], references: [id], onDelete: SetNull)

  @@map("historial_actividad")
}

model DispositivoMfa {
  id            String   @id @default(uuid())
  usuarioId     String
  nombre        String   // Nombre descriptivo del dispositivo
  tipo          String   // EMAIL, SMS, TOTP, etc.
  activo        Boolean  @default(true)
  ultimoUso     DateTime?
  creado        DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("dispositivos_mfa")
}

model Ticket {
  id          String         @id @default(uuid())
  titulo      String
  descripcion String?
  categoria   CategoriaTicket @default(GENERAL)
  estado      EstadoTicket   @default(ABIERTO)
  prioridad   Int            @default(3) // 1=Alta, 2=Media, 3=Baja
  usuarioId   String
  creado      DateTime       @default(now())
  actualizado DateTime       @updatedAt
  cerrado     DateTime?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("tickets")
}
